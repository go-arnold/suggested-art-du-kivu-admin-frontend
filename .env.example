# Variables d'environnement — copier dans .env.local et renseigner

# URL du backend (proxifié via next.config.mjs -> /api/v1).
# Optionnel : valeur par défaut = https://jeremy-backend.onrender.com/api/v1
# BACKEND_API_URL=https://jeremy-backend.onrender.com/api/v1

# Google OAuth Client ID pour le bouton "Continuer avec Google".
# DOIT être le même Client ID que celui configuré dans le backend (allauth),
# sinon l'access_token Google sera refusé par /api/v1/auth/google/.
# Le bouton Google n'apparaît que si cette variable est définie.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
